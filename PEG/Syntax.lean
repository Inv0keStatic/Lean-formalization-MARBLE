import Std

set_option autoImplicit false

namespace PEG

universe u v

inductive Expr (α : Type u) (ν : Type v) where
  | epsilon
  | terminal (a : α)
  | nonterminal (A : ν)
  | seq (left right : Expr α ν)
  | choice (left right : Expr α ν)
  | star (body : Expr α ν)
  | notAhead (body : Expr α ν)
  | wildcard
  | fail
  deriving Repr

abbrev Rules (α : Type u) (ν : Type v) := ν → Expr α ν

def Expr.andAhead {α : Type u} {ν : Type v} (e : Expr α ν) : Expr α ν :=
  .notAhead (.notAhead e)

variable {α : Type u} {ν : Type v}

/-- The least relation generated by the paper's operational rules. -/
inductive Parse (R : Rules α ν) : Expr α ν → List α → Option (List α) → Prop where
  | epsilon {w} : Parse R .epsilon w (some w)
  | terminal {a w} : Parse R (.terminal a) (a :: w) (some w)
  | terminalMismatch {a b w} : a ≠ b → Parse R (.terminal a) (b :: w) none
  | terminalEmpty {a} : Parse R (.terminal a) [] none
  | nonterminal {A w out} :
      Parse R (R A) w out → Parse R (.nonterminal A) w out
  | seqStep {e₁ e₂ x y out} :
      Parse R e₁ (x ++ y) (some y) → Parse R e₂ y out →
      Parse R (.seq e₁ e₂) (x ++ y) out
  | seqFail {e₁ e₂ w} : Parse R e₁ w none → Parse R (.seq e₁ e₂) w none
  | choiceLeft {e₁ e₂ x y} :
      Parse R e₁ (x ++ y) (some y) → Parse R (.choice e₁ e₂) (x ++ y) (some y)
  | choiceRight {e₁ e₂ w out} :
      Parse R e₁ w none → Parse R e₂ w out → Parse R (.choice e₁ e₂) w out
  | starStep {e x y out} :
      Parse R e (x ++ y) (some y) → Parse R (.star e) y out →
      Parse R (.star e) (x ++ y) out
  | starStop {e w} : Parse R e w none → Parse R (.star e) w (some w)
  | notSuccess {e w} : Parse R e w none → Parse R (.notAhead e) w (some w)
  | notFail {e w y} : Parse R e w (some y) → Parse R (.notAhead e) w none
  | wildcard {a w} : Parse R .wildcard (a :: w) (some w)
  | wildcardEmpty : Parse R .wildcard [] none
  | fail {w} : Parse R .fail w none

def FullLanguage (R : Rules α ν) (e : Expr α ν) (w : List α) : Prop :=
  Parse R e w (some [])

end PEG
